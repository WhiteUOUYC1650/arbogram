
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Профіль користувача.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "photoURL": { "type": "string" },
        "email": { "type": "string" },
        "lastSeen": { "type": "number" },
        "status": { "type": "string", "enum": ["online", "offline"] },
        "isBanned": { "type": "boolean" },
        "blockedUsers": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email", "username"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Метадані чату",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "number" },
        "type": { "type": "string", "enum": ["individual", "group", "channel"] },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "object" },
        "typing": { "type": "object" }
      },
      "required": ["participants", "type", "lastMessageTime"]
    },
    "Message": {
      "title": "Message",
      "description": "Повідомлення",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "audio"] },
        "text": { "type": "string" },
        "imageUrls": { "type": "array", "items": { "type": "string" } },
        "audioUrl": { "type": "string" },
        "timestamp": { "type": "number" },
        "reactions": { "type": "object" },
        "replyTo": { "type": "object" }
      },
      "required": ["senderId", "type", "timestamp"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Профілі" },
    "/chats/{chatId}": { "schema": "Chat", "description": "Чати" },
    "/chats/{chatId}/messages/{messageId}": { "schema": "Message", "description": "Повідомлення" }
  }
}
