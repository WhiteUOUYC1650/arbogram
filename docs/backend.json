
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Профиль пользователя мессенджера.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string" },
        "username": { "type": "string", "description": "Уникальный тег пользователя, начинается с @" },
        "photoURL": { "type": "string", "description": "URL или ID аватара" },
        "email": { "type": "string", "format": "email" },
        "lastSeen": { "type": "number" },
        "status": { "type": "string", "enum": ["online", "offline"] },
        "settings": {
          "type": "object",
          "properties": {
            "privacy": { "type": "object" },
            "notifications": { "type": "object" }
          }
        }
      },
      "required": ["uid", "email", "username"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Метаданные чата",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object" },
        "ownerId": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "number" },
        "type": { "type": "string", "enum": ["individual", "group", "channel"] },
        "name": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "object" },
        "typing": { "type": "object" }
      },
      "required": ["participants", "type", "lastMessageTime"]
    },
    "Message": {
      "title": "Message",
      "description": "Сообщение в чате",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "audio", "poll"] },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "audioUrl": { "type": "string" },
        "duration": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["senderId", "type", "timestamp"]
    },
    "Call": {
      "title": "Call",
      "description": "Сигнальные данные звонка WebRTC",
      "type": "object",
      "properties": {
        "callerId": { "type": "string" },
        "receiverId": { "type": "string" },
        "status": { "type": "string", "enum": ["dialing", "ringing", "connected", "ended"] },
        "offer": { "type": "object" },
        "answer": { "type": "object" },
        "timestamp": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Профили" },
    "/chats/{chatId}": { "schema": "Chat", "description": "Чаты" },
    "/chats/{chatId}/messages/{messageId}": { "schema": "Message", "description": "Сообщения" },
    "/calls/{callId}": { "schema": "Call", "description": "Сигналинг звонков" }
  }
}
