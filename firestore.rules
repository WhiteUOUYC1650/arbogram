
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ПРИНУДИТЕЛЬНО ОТКРЫТЫЕ ПРАВИЛА ДЛЯ ВСЕХ АВТОРИЗОВАННЫХ ПОЛЬЗОВАТЕЛЕЙ
    // Это гарантирует, что голосование (update) сработает немедленно.
    // Обновлено: 2026-01-01 (Deployment Fix)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
