rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Проверка авторизации
    function isAuthenticated() {
      return request.auth != null;
    }

    // Проверка, является ли пользователь владельцем документа
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Правила для профилей пользователей
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Правила для чатов
    match /chats/{chatId} {
      // Доступ к чату имеют только его участники
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      // Создавать чат может любой авторизованный пользователь, если он сам в списке участников
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      
      // Обновлять метаданные чата (напр. последнее сообщение) могут только участники
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // Сообщения внутри чата
      match /messages/{messageId} {
        // Доступ к сообщениям только если пользователь участник родительского чата
        allow read, write: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}