
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // РАЗРЕШАЕМ ВСЁ ДЛЯ ЛЮБОГО АВТОРИЗОВАННОГО ПОЛЬЗОВАТЕЛЯ
    // Это гарантирует, что голосование (update) сработает, даже если вы не владелец проекта.
    // Единственное условие - пользователь должен быть залогинен.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
