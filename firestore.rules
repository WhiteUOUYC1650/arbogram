
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Профили пользователей: чтение разрешено всем для корректной регистрации и поиска
    match /users/{userId} {
      allow read: if true; 
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Аватарки: чтение всем, запись владельцу
    match /avatars/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Чаты и сообщения - CoveChat v1.0 «Rebooting»
    match /chats/{chatId} {
      // Разрешаем чтение, создание и обновление всем авторизованным.
      // Это критично для корректной работы мессенджера (обновление метаданных чата при новых сообщениях)
      allow read, create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid);

      match /messages/{messageId} {
        // Разрешаем ЛЮБЫЕ операции записи (create, update) всем авторизованным пользователям.
        // Это гарантирует, что любой участник сможет проголосовать (update) в опросе.
        allow read, write: if isAuthenticated();
      }
    }

    // Истории пользователей
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
  }
}
