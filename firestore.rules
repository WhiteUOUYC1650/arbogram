
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Вспомогательная функция для проверки авторизации
    function isAuthenticated() {
      return request.auth != null;
    }

    // Правила для профилей пользователей
    match /users/{userId} {
      // Любой авторизованный пользователь может видеть чужие профили (для поиска)
      allow read: if isAuthenticated();
      // Только сам пользователь может менять свои данные
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Правила для чатов
    match /chats/{chatId} {
      // Доступ к чату имеют только его участники
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      // Создавать чат может любой, если он сам есть в списке участников
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      
      // Обновлять метаданные (напр. последнее сообщение) могут только участники
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // Правила для сообщений внутри чата
      match /messages/{messageId} {
        // Читать и отправлять сообщения могут только участники родительского чата
        allow read, create: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // В MVP сообщения обычно не редактируются и не удаляются
        allow update, delete: if false;
      }
    }
  }
}
