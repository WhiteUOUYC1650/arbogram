
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Профили пользователей: чтение всем, запись владельцу
    match /users/{userId} {
      allow read: if true; 
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Аватарки
    match /avatars/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Чаты и сообщения - МАКСИМАЛЬНЫЙ ДОСТУП ДЛЯ ИСПРАВЛЕНИЯ ОШИБКИ
    match /chats/{chatId} {
      // Разрешаем любые действия авторизованным пользователям
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        // Разрешаем чтение и запись (включая update для голосования) всем вошедшим
        allow read, write: if isAuthenticated();
      }
    }

    // Истории пользователей
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
  }
}
