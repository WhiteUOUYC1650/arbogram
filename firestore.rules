rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Профили: читать могут все, писать только владелец
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Аватары: публичное чтение, запись только владельцем
    match /avatars/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Чаты и сообщения
    match /chats/{chatId} {
      // Доступ к чату если ты участник или чат публичный
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || 
        resource.data.isPublic == true
      );
      
      allow create: if isAuthenticated();
      
      // Обновление метаданных (последнее сообщение и т.д.)
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || 
        resource.data.isPublic == true
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        // Писать могут участники или в публичный чат любой вошедший
        allow create: if isAuthenticated();
        
        // Удаление разрешено автору или владельцу чата
        allow delete: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid
        );
      }
    }

    // Истории
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
