rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Проверка авторизации пользователя
    function isAuthenticated() {
      return request.auth != null;
    }

    // Проверка, является ли пользователь участником чата
    function isChatParticipant(chatId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{userId} {
      // Все авторизованные пользователи могут искать других по юзернейму
      allow read: if isAuthenticated();
      // Только владелец профиля может записывать свои данные
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      // Доступ к чату (чтение и обновление) только для участников
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      // Создавать чат может любой авторизованный, если он включил себя в список участников
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      
      // Обновлять чат (например, менять последнее сообщение или добавлять участников) могут текущие участники
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || 
        (resource.data.type == "group" && request.auth.uid == resource.data.ownerId)
      );

      match /messages/{messageId} {
        // Сообщения доступны только участникам конкретного чата
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId);
      }
    }
  }
}