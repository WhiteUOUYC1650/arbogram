
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Позволяем всем авторизованным искать пользователей по username
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      // Доступ к чату только для участников
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      // Создавать чат может любой авторизованный, если он есть в списке участников
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      
      // Обновлять чат могут участники (для lastMessage) или владелец
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || 
        request.auth.uid == resource.data.ownerId
      );

      match /messages/{messageId} {
        // Сообщения доступны только участникам чата
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
