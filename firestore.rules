
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Функция проверки авторизации
    function isAuthenticated() {
      return request.auth != null;
    }

    // Профили пользователей: читать могут все вошедшие, писать - только владелец
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Чаты и сообщения: для MVP разрешаем доступ всем авторизованным пользователям.
    // Это гарантирует, что "Missing permissions" не возникнет из-за сложных проверок участия.
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
