
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // МАКСИМАЛЬНО ОТКРЫТЫЕ ПРАВИЛА ДЛЯ ВСЕХ АВТОРИЗОВАННЫХ ПОЛЬЗОВАТЕЛЕЙ
    // Это гарантирует, что голосование (update) сработает, даже если вы не владелец проекта.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
