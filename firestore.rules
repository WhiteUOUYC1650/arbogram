rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Публичная иконка приложения
    match /config/appicon {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      // Разрешаем чтение всем, чтобы работал поиск по юзернейму и проверка при регистрации
      allow read: if true; 
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /avatars/{userId} {
      // Аватарки должны быть видны всем пользователям
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      // Упрощаем правила для MVP, чтобы избежать ошибок Missing Permissions при сложных запросах
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.participants
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }

    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
  }
}