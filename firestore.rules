
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Публичная иконка приложения для экрана логина
    match /config/appicon {
      allow read: if true;
      allow write: if false; // Только через консоль
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /avatars/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      // Читать чат могут участники ИЛИ если это публичный канал
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || 
        (resource.data.type == "channel" && resource.data.isPublic == true)
      );
      
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || 
        request.auth.uid == resource.data.ownerId
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.type == "channel"
        );
        
        allow create: if isAuthenticated() && (
          (get(/databases/$(database)/documents/chats/$(chatId)).data.type != "channel" && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.type == "channel" && request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId)
        );
        
        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId
        );
      }
    }

    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
  }
}
