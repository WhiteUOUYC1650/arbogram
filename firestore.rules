
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Профили пользователей: чтение всем для регистрации и поиска
    match /users/{userId} {
      allow read: if true; 
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Аватарки: чтение всем, запись владельцу
    match /avatars/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Чаты и сообщения - CoveChat v1.0 «Rebooting»
    match /chats/{chatId} {
      // Разрешаем чтение и обновление всем авторизованным для корректной работы мессенджера
      allow read, create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid);

      match /messages/{messageId} {
        // Разрешаем обновление всем авторизованным. Это КРИТИЧЕСКИ ВАЖНО для голосования в опросах.
        allow read, create, update: if isAuthenticated();
        allow delete: if isAuthenticated(); 
      }
    }

    // Истории пользователей
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
  }
}
